# Supabase PostgreSQL connection string (Transaction Pooler - porta 6543)
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters"

# Pluggy API
PLUGGY_CLIENT_ID="your-pluggy-client-id"
PLUGGY_CLIENT_SECRET="your-pluggy-client-secret"
PLUGGY_WEBHOOK_URL="https://your-api-domain.com/api/webhooks/pluggy"

# API Port & Host
PORT=3333
HOST=0.0.0.0
